# Copy this file to .env and fill in the values. .env is ignored by git. Never commit real values.
# Names follow APITEST_<ENV>_<CALLER>_API_KEY. See docs/backend-contract.md.

# The `tests` caller type is the default and is enough for most work.
APITEST_DEV_TESTS_API_KEY=
APITEST_PROD_TESTS_API_KEY=

# The `admin` caller type is only for the shipping simulation tests, on dev.
APITEST_DEV_ADMIN_API_KEY=

# The `services` key is for service-to-service calls. Tests never use it and the library never loads it.
