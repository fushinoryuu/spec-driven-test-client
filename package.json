{
  "name": "spec-driven-test-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed, spec-driven API clients and vitest helpers for integration tests",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "copy-specs": "node scripts/copy-specs.ts",
    "check-stage": "node scripts/check-stage.ts",
    "mock": "node mock/start.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
